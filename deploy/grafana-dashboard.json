{
  "dashboard": {
    "uid": "milesahead",
    "title": "Miles Ahead",
    "tags": ["milesahead"],
    "timezone": "browser",
    "refresh": "30s",
    "time": { "from": "now-24h", "to": "now" },
    "panels": [
      {
        "id": 1,
        "type": "timeseries",
        "title": "Request Rate",
        "gridPos": { "x": 0, "y": 0, "w": 6, "h": 8 },
        "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "stacking": { "mode": "normal" },
              "fillOpacity": 30
            },
            "unit": "reqps"
          },
          "overrides": []
        },
        "options": {
          "tooltip": { "mode": "multi" },
          "legend": { "displayMode": "table", "placement": "bottom" }
        },
        "targets": [
          {
            "expr": "sum(rate(milesahead_http_requests_total[5m])) by (path)",
            "legendFormat": "{{ path }}",
            "refId": "A",
            "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" }
          }
        ]
      },
      {
        "id": 2,
        "type": "timeseries",
        "title": "Latency P95",
        "gridPos": { "x": 6, "y": 0, "w": 6, "h": 8 },
        "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" },
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          },
          "overrides": []
        },
        "options": {
          "tooltip": { "mode": "multi" },
          "legend": { "displayMode": "table", "placement": "bottom" }
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(milesahead_http_duration_seconds_bucket[5m])) by (le, path))",
            "legendFormat": "{{ path }}",
            "refId": "A",
            "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" }
          }
        ]
      },
      {
        "id": 3,
        "type": "timeseries",
        "title": "Status Codes",
        "gridPos": { "x": 12, "y": 0, "w": 6, "h": 8 },
        "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "stacking": { "mode": "normal" },
              "fillOpacity": 30
            },
            "unit": "reqps"
          },
          "overrides": []
        },
        "options": {
          "tooltip": { "mode": "multi" },
          "legend": { "displayMode": "table", "placement": "bottom" }
        },
        "targets": [
          {
            "expr": "sum(rate(milesahead_http_requests_total[5m])) by (status)",
            "legendFormat": "{{ status }}",
            "refId": "A",
            "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" }
          }
        ]
      },
      {
        "id": 4,
        "type": "table",
        "title": "Top Pages",
        "gridPos": { "x": 18, "y": 0, "w": 6, "h": 8 },
        "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" },
        "fieldConfig": {
          "defaults": {},
          "overrides": []
        },
        "options": {
          "showHeader": true,
          "sortBy": [{ "displayName": "Value", "desc": true }]
        },
        "targets": [
          {
            "expr": "topk(10, sum(increase(milesahead_http_requests_total[24h])) by (path))",
            "legendFormat": "{{ path }}",
            "refId": "A",
            "format": "table",
            "instant": true,
            "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" }
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": { "Time": true },
              "renameByName": { "path": "Page", "Value": "Requests" }
            }
          }
        ]
      },
      {
        "id": 5,
        "type": "stat",
        "title": "Error Rate",
        "gridPos": { "x": 0, "y": 9, "w": 6, "h": 8 },
        "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.01 },
                { "color": "red", "value": 0.05 }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "reduceOptions": { "calcs": ["lastNotNull"] }
        },
        "targets": [
          {
            "expr": "sum(rate(milesahead_http_requests_total{status=~\"4..|5..\"}[5m])) / sum(rate(milesahead_http_requests_total[5m]))",
            "legendFormat": "Error Rate",
            "refId": "A",
            "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" }
          }
        ]
      },
      {
        "id": 6,
        "type": "timeseries",
        "title": "Response Size P95",
        "gridPos": { "x": 6, "y": 9, "w": 6, "h": 8 },
        "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" },
        "fieldConfig": {
          "defaults": {
            "unit": "bytes"
          },
          "overrides": []
        },
        "options": {
          "tooltip": { "mode": "multi" },
          "legend": { "displayMode": "table", "placement": "bottom" }
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(milesahead_http_response_bytes_bucket[5m])) by (le, path))",
            "legendFormat": "{{ path }}",
            "refId": "A",
            "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" }
          }
        ]
      },
      {
        "id": 7,
        "type": "timeseries",
        "title": "Unique Visitors",
        "gridPos": { "x": 12, "y": 9, "w": 12, "h": 8 },
        "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" },
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "tooltip": { "mode": "single" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        },
        "targets": [
          {
            "expr": "increase(milesahead_daily_unique_visitors_total[24h])",
            "legendFormat": "Unique Visitors",
            "refId": "A",
            "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" }
          }
        ]
      },
      {
        "id": 8,
        "type": "stat",
        "title": "Articles Generated",
        "gridPos": { "x": 0, "y": 18, "w": 6, "h": 4 },
        "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "blue", "value": null }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "reduceOptions": { "calcs": ["lastNotNull"] }
        },
        "targets": [
          {
            "expr": "sum(milesahead_articles_generated_total)",
            "legendFormat": "Generated",
            "refId": "A",
            "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" }
          }
        ]
      },
      {
        "id": 9,
        "type": "stat",
        "title": "Approved / Rejected",
        "gridPos": { "x": 6, "y": 18, "w": 6, "h": 4 },
        "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" },
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "Approved" },
              "properties": [
                { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }
              ]
            },
            {
              "matcher": { "id": "byName", "options": "Rejected" },
              "properties": [
                { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
              ]
            }
          ]
        },
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "reduceOptions": { "calcs": ["lastNotNull"] }
        },
        "targets": [
          {
            "expr": "sum(milesahead_articles_generated_total{status=\"approved\"})",
            "legendFormat": "Approved",
            "refId": "A",
            "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" }
          },
          {
            "expr": "sum(milesahead_articles_generated_total{status=\"rejected\"})",
            "legendFormat": "Rejected",
            "refId": "B",
            "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" }
          }
        ]
      },
      {
        "id": 10,
        "type": "stat",
        "title": "Subscribers",
        "gridPos": { "x": 12, "y": 18, "w": 6, "h": 4 },
        "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "purple", "value": null }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "reduceOptions": { "calcs": ["lastNotNull"] }
        },
        "targets": [
          {
            "expr": "milesahead_subscribers_total",
            "legendFormat": "Subscribers",
            "refId": "A",
            "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" }
          }
        ]
      },
      {
        "id": 11,
        "type": "timeseries",
        "title": "AI Latency P95",
        "gridPos": { "x": 0, "y": 23, "w": 6, "h": 8 },
        "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" },
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          },
          "overrides": []
        },
        "options": {
          "tooltip": { "mode": "single" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(milesahead_ai_api_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "P95",
            "refId": "A",
            "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" }
          }
        ]
      },
      {
        "id": 12,
        "type": "timeseries",
        "title": "Critic Scores",
        "gridPos": { "x": 6, "y": 23, "w": 6, "h": 8 },
        "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 30,
              "drawStyle": "bars"
            },
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "tooltip": { "mode": "multi" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        },
        "targets": [
          {
            "expr": "milesahead_critic_score_bucket",
            "legendFormat": "{{ le }}",
            "refId": "A",
            "format": "heatmap",
            "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" }
          }
        ]
      },
      {
        "id": 13,
        "type": "bargauge",
        "title": "Scan Status",
        "gridPos": { "x": 12, "y": 23, "w": 6, "h": 8 },
        "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient",
          "reduceOptions": { "calcs": ["lastNotNull"] }
        },
        "targets": [
          {
            "expr": "sum(increase(milesahead_scans_total[24h])) by (source, status)",
            "legendFormat": "{{ source }} - {{ status }}",
            "refId": "A",
            "instant": true,
            "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" }
          }
        ]
      },
      {
        "id": 14,
        "type": "stat",
        "title": "Image Pipeline",
        "gridPos": { "x": 18, "y": 23, "w": 6, "h": 8 },
        "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 0.5 },
                { "color": "green", "value": 0.9 }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "reduceOptions": { "calcs": ["lastNotNull"] }
        },
        "targets": [
          {
            "expr": "sum(rate(milesahead_image_search_total{status=\"success\"}[24h])) / sum(rate(milesahead_image_search_total[24h]))",
            "legendFormat": "Search",
            "refId": "A",
            "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" }
          },
          {
            "expr": "sum(rate(milesahead_image_scoring_total{status=\"success\"}[24h])) / sum(rate(milesahead_image_scoring_total[24h]))",
            "legendFormat": "Scoring",
            "refId": "B",
            "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" }
          },
          {
            "expr": "sum(rate(milesahead_image_selection_total{status=\"success\"}[24h])) / sum(rate(milesahead_image_selection_total[24h]))",
            "legendFormat": "Selection",
            "refId": "C",
            "datasource": { "uid": "DS_PLACEHOLDER", "type": "prometheus" }
          }
        ]
      }
    ]
  },
  "folderUid": "",
  "overwrite": true
}